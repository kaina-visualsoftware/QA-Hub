# Somente valores PUBLICÁVEIS. Nunca usar service_role, sb_secret_ ou tokens de IA aqui.
# Se omitidos, o cliente usa os mesmos valores públicos já presentes em qa-config.js.
VITE_SUPABASE_URL=https://pqadmlhcsimlcclpkyov.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Mantenha qa.html enquanto o rollout React não for homologado.
# Após incluir a nova URL na allowlist do Supabase Auth, habilite o callback isolado:
# VITE_AUTH_REDIRECT_URL=https://kaina-visualsoftware.github.io/QA-Hub/auth.html
# Para preview local (depois de permitir a URL), ex.: http://localhost:8765/QA-Hub/auth.html
VITE_AUTH_REDIRECT_URL=https://kaina-visualsoftware.github.io/QA-Hub/qa.html

# Trava de segurança: novas publicações ficam DESATIVADAS por padrão.
# Habilitar somente após instalar a API pública segura, remover SELECT
# indevido nas tabelas e validar o staging com duas contas e visitante anon.
# VITE_PUBLIC_SHARING_ENABLED=true
